[configuration]

entry_symbol = "opensim_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://bin/opensim_gdext.dll"
windows.release.x86_64 = "res://bin/opensim_gdext.dll"
linux.debug.x86_64 = "res://bin/libopensim_gdext.so"
linux.release.x86_64 = "res://bin/libopensim_gdext.so"